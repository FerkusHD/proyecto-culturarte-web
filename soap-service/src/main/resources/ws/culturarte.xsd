<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.culturarte.com/ws"
           xmlns:tns="http://www.culturarte.com/ws"
           xmlns:tipos="http://www.culturarte.com/ws/tipos"
           xmlns:usuarios="http://www.culturarte.com/ws/usuarios"
           xmlns:propuestas="http://www.culturarte.com/ws/propuestas"
           xmlns:categorias="http://www.culturarte.com/ws/categorias"
           xmlns:espectaculos="http://www.culturarte.com/ws/espectaculos"
           elementFormDefault="qualified">

    <!-- Imports de todos los XSD -->
    <xs:import namespace="http://www.culturarte.com/ws/tipos" schemaLocation="tipos.xsd"/>
    <xs:import namespace="http://www.culturarte.com/ws/usuarios" schemaLocation="usuarios.xsd"/>
    <xs:import namespace="http://www.culturarte.com/ws/propuestas" schemaLocation="propuestas.xsd"/>
    <xs:import namespace="http://www.culturarte.com/ws/categorias" schemaLocation="categorias.xsd"/>
    <xs:import namespace="http://www.culturarte.com/ws/espectaculos" schemaLocation="espectaculos.xsd"/>

    <!-- Operaciones principales -->
    <xs:element name="pingRequest" type="xs:anyType"/>
    <xs:element name="pingResponse" type="xs:anyType"/>

    <xs:element name="getUsuariosRequest" type="xs:anyType"/>
    <xs:element name="getUsuariosResponse" type="usuarios:getUsuariosResponse"/>

    <xs:element name="getPropuestasRequest" type="xs:anyType"/>
    <xs:element name="getPropuestasResponse" type="propuestas:listarPropuestasResponse"/>

    <xs:element name="getCategoriasRequest" type="xs:anyType"/>
    <xs:element name="getCategoriasResponse" type="categorias:getCategoriasResponse"/>

    <xs:element name="getEspectaculoRequest" type="espectaculos:getEspectaculoRequest"/>
    <xs:element name="getEspectaculoResponse" type="espectaculos:getEspectaculoResponse"/>

</xs:schema>
