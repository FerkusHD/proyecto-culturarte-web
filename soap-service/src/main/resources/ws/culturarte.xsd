<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.culturarte.com/ws"
           xmlns:tns="http://www.culturarte.com/ws"
           xmlns:tipos="http://www.culturarte.com/ws/tipos"
           xmlns:usuarios="http://www.culturarte.com/ws/usuarios"
           xmlns:propuestas="http://www.culturarte.com/ws/propuestas"
           elementFormDefault="qualified">

    <xs:import namespace="http://www.culturarte.com/ws/tipos" 
               schemaLocation="tipos.xsd"/>
    <xs:import namespace="http://www.culturarte.com/ws/usuarios" 
               schemaLocation="usuarios.xsd"/>
    <xs:import namespace="http://www.culturarte.com/ws/propuestas" 
               schemaLocation="propuestas.xsd"/>

    <xs:element name="pingRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="message" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="pingResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="message" type="xs:string"/>
                <xs:element name="timestamp" type="xs:dateTime"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Operaciones de alto nivel -->
    <xs:element name="getPropuestasRequest">
        <xs:complexType>
            <xs:sequence/>
        </xs:complexType>
    </xs:element>

    <xs:element name="getPropuestasResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="propuestas" type="propuestas:propuestaType" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getUsuariosRequest">
        <xs:complexType>
            <xs:sequence/>
        </xs:complexType>
    </xs:element>

    <xs:element name="getUsuariosResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="usuarios" type="usuarios:usuarioType" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
