<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://culturarte.com/ws/colaboraciones"
           xmlns:tns="http://culturarte.com/ws/colaboraciones"
           elementFormDefault="qualified">

    <!-- Request y Response para listar colaboraciones -->
    <xs:element name="getColaboracionesPorUsuarioRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nickname" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getColaboracionesPorUsuarioResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="colaboraciones" type="tns:DTColaboracion" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Request y Response para una colaboración -->
    <xs:element name="getColaboracionRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nickColaborador" type="xs:string"/>
                <xs:element name="tituloPropuesta" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getColaboracionResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="colaboracion" type="tns:DTColaboracion" minOccurs="0"/>
                <xs:element name="propuesta" type="tns:DTPropuesta" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Tipos -->
    <xs:complexType name="DTColaboracion">
        <xs:sequence>
            <xs:element name="nickColaborador" type="xs:string"/>
            <xs:element name="tituloPropuesta" type="xs:string"/>
            <xs:element name="fecha" type="xs:string"/>
            <xs:element name="hora" type="xs:string"/>
            <xs:element name="monto" type="xs:float"/>
            <xs:element name="tipoRetorno" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="DTPropuesta">
        <xs:sequence>
            <xs:element name="titulo" type="xs:string"/>
            <xs:element name="descripcion" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
