<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Culturarte Web Application</display-name>
    <description>Configuración de la aplicación web Culturarte</description>

    <!-- Configuración del Servidor Central (SOAP Service) -->
    <context-param>
        <param-name>soap.service.host</param-name>
        <param-value>${SOAP_SERVICE_HOST:localhost}</param-value>
        <description>Dirección IP o hostname del Servidor Central que publica los Web Services SOAP</description>
    </context-param>

    <context-param>
        <param-name>soap.service.port</param-name>
        <param-value>${SOAP_SERVICE_PORT:8081}</param-value>
        <description>Puerto del Servidor Central que publica los Web Services SOAP</description>
    </context-param>

    <context-param>
        <param-name>soap.service.context-path</param-name>
        <param-value>${SOAP_SERVICE_CONTEXT_PATH:/soap/ws}</param-value>
        <description>Context path base donde se publican los Web Services SOAP</description>
    </context-param>

    <context-param>
        <param-name>soap.service.url</param-name>
        <param-value>${SOAP_SERVICE_URL:http://localhost:8081/soap/ws}</param-value>
        <description>URL completa del Servidor Central para consumir Web Services SOAP. 
                     Se construye automáticamente desde host, port y context-path si no se especifica.</description>
    </context-param>

    <!-- Configuración de Spring -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>classpath:application.properties</param-value>
    </context-param>

    <!-- Listener para inicializar Spring -->
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <!-- Servlet para Spring MVC -->
    <servlet>
        <servlet-name>dispatcher</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value></param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

</web-app>

