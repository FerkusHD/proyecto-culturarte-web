# ============================
# SO y archivos varios
# ============================
.DS_Store
Thumbs.db
*.orig

# ============================
# Docker / Compose / Entorno
# ============================
.env
*.env
docker-compose.override.yml

# ============================
# Datos locales (no versionar)
# ============================
# Directorios de datos de MySQL
web-app/mysql/data/

# Subidas locales (imágenes, etc.)
uploads/

